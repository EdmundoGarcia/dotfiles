background {
    monitor =
    path = /home/ed/Pictures/Wallpapers/wallhaven-ly3gmr.png
    color = rgba(25, 20, 20, 1.0)
    blur_passes = 2
}

input-field {
    monitor =
    size = 250, 50
    outline_thickness = 3
    dots_size = 0.33 
    dots_spacing = 0.15 
    dots_center = true
    outer_color = rgb(151515)
    inner_color = rgb(200, 200, 200)
    font_color = rgb(10, 10, 10)
    fade_on_empty = false 
    
    placeholder_text = <i> Password...</i>
    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i> 
    fail_color = rgb(204, 34, 34) 
    
    position = 0, -20
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    color = rgba(200, 200, 200, 1.0)
    font_size = 64
    font_family = Noto Sans
    position = 0, 80
    halign = center
    valign = center
}
