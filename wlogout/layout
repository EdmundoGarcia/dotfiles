{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Save Game",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "Quit to Title",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Respawn",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Exit Game",
    "keybind" : "s"
}
{
    "label" : "sleep",
    "action" : "systemctl suspend",
    "text" : "Bedtime",
    "keybind" : "z"
}
