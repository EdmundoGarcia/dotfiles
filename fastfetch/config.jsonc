{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "keys": "red",
      "title": "red",
      "output": "white"
    }
  },
  "logo": {
    "source": "/home/ed/.config/fastfetch/arch_art.txt",
    "position": "left",
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "modules": [
    {
      "type": "title",
      "padding": {
        "top": 2
      }
    },
    "separator",
    { "type": "os", "key": "󰣇" },
    { "type": "host", "key": "󰌢" },
    { "type": "kernel", "key": "󰒋" },
    { "type": "uptime", "key": "󱎫" },
    { "type": "packages", "key": "󰏖" },
    { "type": "shell", "key": "󱆃" },
    { "type": "display", "key": "󰍹" },
    { "type": "de", "key": "󰖲" },
    { "type": "wm", "key": "󱂬" },
    { "type": "wmtheme", "key": "󰉼" },
    { "type": "theme", "key": "󰔎" },
    { "type": "icons", "key": "󰀻" },
    { "type": "font", "key": "󰛖" },
    { "type": "cursor", "key": "󰇀" },
    { "type": "terminal", "key": "󰆍" },
    { "type": "terminalfont", "key": "󰅳" },
    { "type": "cpu", "key": "󰻠" },
    { "type": "gpu", "key": "󰢮" },
    { "type": "memory", "key": "󰍛" },
    { "type": "disk", "key": "󰋊" },
    { "type": "battery", "key": "󰁹" },
    { "type": "poweradapter", "key": "󰚥" },
    "break",
  ]
}
